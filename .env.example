# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for dispatching real 6-digit email verification OTPs.
# Obtain your key at https://resend.com/api-keys
# Set this in your local .env and in Netlify / Cloud Run environment settings.
RESEND_API_KEY="re_123456789"

# FROM_EMAIL: Verified sender address for transactional verification emails.
# In development, Resend allows 'onboarding@resend.dev'. In production, use your custom verified domain.
FROM_EMAIL="HEAVENLY-RUN ENERGY <onboarding@resend.dev>"
